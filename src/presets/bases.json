{
  "systems": [
    {
      "id": "opr",
      "name": "One Page Rules",
      "notes": "Dimensions match the \"S - Bases\" STL library shipped with this app. Community-designed sizes for OPR games (Grimdark Future, Age of Fantasy, Firefight, etc). OPR's oval is 75x46 where GW uses 75x42."
    },
    {
      "id": "40k",
      "name": "Warhammer 40,000 (11th ed)",
      "notes": "11th edition (June 2026); base sizes are unchanged from 10th edition. GW publishes no official base-size chart — sizes are inferred from datasheets and kit contents. No square or rectangular bases in this system."
    },
    {
      "id": "old-world",
      "name": "Warhammer: The Old World",
      "notes": "Infantry base size moved from 20mm (Warhammer Fantasy Battle 8th ed) to 25mm. No oval bases in this system; unit footprints are rank-and-file rectangles."
    },
    {
      "id": "kow",
      "name": "Kings of War (Mantic)",
      "notes": "Individual model base size is not rules-relevant — only the outer footprint of the full unit matters for movement, range and combat. 4th edition (Dec 2025) enlarged hero bases to 40x40/50x50, removed Legions as a standard size for most troop types, and moved Large Infantry/Cavalry to Troop+Regiment."
    }
  ],
